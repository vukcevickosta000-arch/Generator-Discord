<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-only check of the Unity client scripts against Unity reference assemblies (UnityEngine.Modules 2021.3
    from NuGet; the client targets Unity 6 but uses APIs present in both). URP / Input System code is behind
    BLOODFALL_URP / BLOODFALL_INPUT_SYSTEM and is not compiled here. Run: dotnet build Tools/UnityCompileCheck
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS1701;CS1702</NoWarn>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR_CHECK;UNITY_2021_3_OR_NEWER</DefineConstants>
    <UnityRefs>$(MSBuildThisFileDirectory)refs</UnityRefs>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Shared/Runtime/**/*.cs" LinkBase="Shared" />
    <Compile Include="../../Client/Assets/Scripts/**/*.cs" Exclude="../../Client/Assets/Scripts/Editor/**" LinkBase="Client" />
  </ItemGroup>
  <Target Name="AddUnityRefs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Include="$(PkgUnityEngine_Modules)/lib/net45/*.dll" Private="false" />
    </ItemGroup>
  </Target>
</Project>
