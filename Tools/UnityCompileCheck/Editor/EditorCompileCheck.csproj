<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-only check of the Unity *editor* scripts against the Unity3D.SDK reference package (2021.1 - the newest on
    NuGet). A few newer APIs used by the Unity 6 project (NamedBuildTarget, PackageInfo.FindForAssetPath...) do not
    exist in 2021.1; those errors are expected and listed in TESTING.md. Run: dotnet build Tools/UnityCompileCheck/Editor
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" />
    <ProjectReference Include="../UnityCompileCheck.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../Client/Assets/Scripts/Editor/**/*.cs" LinkBase="Editor" />
  </ItemGroup>
</Project>
